
PORT=3001


FRONTEND_URL=http://localhost:5173


PRIVATE_KEY=0xTU_CLAVE_PRIVADA_AQUI_64_CARACTERES_HEXADECIMALES

RPC_URL=https://sepolia.infura.io/v3/TU_INFURA_PROJECT_ID

# 📜 CONTRACT_ADDRESS - Dirección del smart contract desplegado en Sepolia
# Obtenerla después de desplegar el contrato en Remix o Hardhat
# Puedes verificarla en: https://sepolia.etherscan.io/
# Formato: 0x seguido de 40 caracteres hexadecimales
CONTRACT_ADDRESS=0xDIRECCION_DEL_CONTRATO_DESPLEGADO

# ========================================
# SECURITY
# ========================================

# 🔐 JWT_SECRET - Secreto para firmar los tokens JWT
# Debe ser una cadena larga y aleatoria
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo recomendado: 32 caracteres
JWT_SECRET=tu_secreto_jwt_muy_largo_y_aleatorio_minimo_32_caracteres

# ========================================
# OPTIONAL
# ========================================

# Ambiente de ejecución (development o production)
NODE_ENV=development
