# ========================================
# CONFIGURACIÓN DEL BACKEND - CRYPTOFAUCET
# ========================================

# Puerto en el que correrá el servidor
# Por defecto: 3001
PORT=3001

# URL del frontend para configurar CORS
# Cambiar si el frontend corre en otro puerto o dominio
FRONTEND_URL=http://localhost:5173

# ========================================
# BLOCKCHAIN CONFIGURATION
# ========================================

# 🔑 PRIVATE_KEY - Clave privada de la wallet que pagará el gas
# ⚠️ IMPORTANTE: 
#   - Esta wallet DEBE tener ETH en Sepolia para pagar las transacciones
#   - NUNCA compartas esta clave ni la subas a GitHub
#   - Usa una wallet dedicada solo para este proyecto
#   - Obtén la clave desde MetaMask: Menú → Detalles de cuenta → Exportar clave privada
# Formato: 0x seguido de 64 caracteres hexadecimales
PRIVATE_KEY=0xTU_CLAVE_PRIVADA_AQUI_64_CARACTERES_HEXADECIMALES

# 🌐 RPC_URL - URL del proveedor de conexión a la red Sepolia
# Opciones:
#   - Infura: https://infura.io/ (Gratis hasta 100k req/día)
#   - Alchemy: https://www.alchemy.com/ (Gratis hasta 300M unidades/mes)
#   - QuickNode: https://www.quicknode.com/
# Formato Infura: https://sepolia.infura.io/v3/TU_API_KEY
# Formato Alchemy: https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
RPC_URL=https://sepolia.infura.io/v3/TU_INFURA_PROJECT_ID

# 📜 CONTRACT_ADDRESS - Dirección del smart contract desplegado en Sepolia
# Obtenerla después de desplegar el contrato en Remix o Hardhat
# Puedes verificarla en: https://sepolia.etherscan.io/
# Formato: 0x seguido de 40 caracteres hexadecimales
CONTRACT_ADDRESS=0xDIRECCION_DEL_CONTRATO_DESPLEGADO

# ========================================
# SECURITY
# ========================================

# 🔐 JWT_SECRET - Secreto para firmar los tokens JWT
# Debe ser una cadena larga y aleatoria
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo recomendado: 32 caracteres
JWT_SECRET=tu_secreto_jwt_muy_largo_y_aleatorio_minimo_32_caracteres

# ========================================
# OPTIONAL
# ========================================

# Ambiente de ejecución (development o production)
NODE_ENV=development
